+void LibMpvPlayer::DrainEvents() {
+    if (mpv_ == nullptr) return;
+    ReadDrainWakeupFd();
+
+    auto set_state = [this](PlayerState new_state) {
+        const PlayerState prev =
+            state_.exchange(new_state, std::memory_order_relaxed);
+        if (prev != new_state && on_state_changed_) {
+            try {
+                on_state_changed_(new_state);
+            } catch (...) {
+                // Listener errors must never break the loop.
+            }
+        }
+    };
+
+    while (true) {
+        mpv_event* ev = mpv_wait_event(mpv_, 0);
+        if (ev == nullptr || ev->event_id == MPV_EVENT_NONE) {
+            break;
+        }
+        switch (ev->event_id) {
+            case MPV_EVENT_START_FILE:
+                if (auto* start = static_cast<mpv_event_start_file*>(ev->data);
+                    start) {
+                    started_entry_id_ = start->playlist_entry_id;
+                    if (stop_barrier_) await_idle_ = true;
+                    if (start->playlist_entry_id == retired_exclusive_id_) break;
+                } else { event_overflow_ = true; }
+                set_state(PlayerState::kLoading);
+                LVA_LOGD(kTag, "event: START_FILE");
+                break;
+            case MPV_EVENT_FILE_LOADED:
+                set_state(PlayerState::kPlaying);
+                LVA_LOGD(kTag, "event: FILE_LOADED");
+                break;
+            case MPV_EVENT_END_FILE: {
+                auto* end = static_cast<mpv_event_end_file*>(ev->data);
+                if (end && end->playlist_entry_id == started_entry_id_) started_entry_id_ = -1;
+                if (end && end->playlist_entry_id == retired_exclusive_id_) {
+                    retired_exclusive_id_ = -1; break;
+                }
+                if (exclusive_ && (!end || exclusive_entry_id_ < 0 ||
+                    end->playlist_entry_id != exclusive_entry_id_)) break;
+                const int reason = end ? static_cast<int>(end->reason) : -1;
+                LVA_LOGD(kTag, "event: END_FILE (reason=%d)", reason);
+                set_state(PlayerState::kIdle);
+                if ((!exclusive_ && (reason == MPV_END_FILE_REASON_EOF || reason == MPV_END_FILE_REASON_ERROR)) ||
+                    (exclusive_ && reason == MPV_END_FILE_REASON_EOF && end &&
+                     exclusive_entry_id_ >= 0 && end->playlist_entry_id == exclusive_entry_id_)) {
+                    std::function<void()> cb;
+                    {
+                        std::lock_guard<std::mutex> lk(cb_mutex_);
+                        cb = std::move(done_callback_);
+                        done_callback_ = nullptr;
+                    }
+                    if (exclusive_) exclusive_entry_id_ = -1;
+                    if (cb) {
+                        try {
+                            cb();
+                        } catch (...) {
+                        }
+                    }
+                }
+                if (exclusive_ && end && end->playlist_entry_id == exclusive_entry_id_)
+                    exclusive_entry_id_ = -1;
+                break;
+            }
+            case MPV_EVENT_IDLE:
+                await_idle_ = false; event_overflow_ = false; started_entry_id_ = -1;
+                retired_exclusive_id_ = -1; break;
+            case MPV_EVENT_QUEUE_OVERFLOW:
+                event_overflow_ = true; break;
+            case MPV_EVENT_LOG_MESSAGE: {
+                auto* m = static_cast<mpv_event_log_message*>(ev->data);
+                if (m && m->level && m->text) {
+                    LVA_LOGD(kTag, "[mpv:%s] %s", m->level, m->text);
+                }
+                break;
+            }
+            case MPV_EVENT_SHUTDOWN:
+                LVA_LOGI(kTag, "event: SHUTDOWN");
+                set_state(PlayerState::kIdle);
+                return;
+            default:
+                LVA_LOGD(kTag, "event: %s", mpv_event_name(ev->event_id));
+                break;
+        }
+    }
