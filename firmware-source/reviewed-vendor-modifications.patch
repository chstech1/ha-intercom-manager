+    if (!exclusive_ || !mpv_ || !idle_event_enabled_ || !stop_barrier_) return false;
+    DrainEvents();
+    if (await_idle_ || event_overflow_) return false;
+    retired_exclusive_id_ = -1;
+    return true;
+}
+bool LibMpvPlayer::PlayExclusive(const std::string& url, std::function<void()> done_callback) {
+    if (!ReadyForExclusive()) return false;
+    // Append is non-playing; get this exact entry ID before selecting it.
+    const char* append[] = {"loadfile", url.c_str(), "append", nullptr};
+    mpv_node result{};
+    if (mpv_command_ret(mpv_, append, &result) < 0) return false;
+    std::int64_t id = -1;
+    if (result.format == MPV_FORMAT_NODE_MAP && result.u.list) {
+        for (int i = 0; i < result.u.list->num; ++i) {
+            const auto& value = result.u.list->values[i];
+            if (result.u.list->keys[i] && std::strcmp(result.u.list->keys[i], "playlist_entry_id") == 0 &&
+                value.format == MPV_FORMAT_INT64) id = value.u.int64;
+        }
+    }
+    mpv_free_node_contents(&result);
+    std::int64_t count = 0, index = -1;
+    if (id >= 0 && mpv_get_property(mpv_, "playlist/count", MPV_FORMAT_INT64, &count) >= 0 &&
+        count >= 1 && count <= 1024) {
+        for (std::int64_t i = 0; i < count; ++i) {
+            std::int64_t candidate = -1;
+            const std::string key = "playlist/" + std::to_string(i) + "/id";
+            if (mpv_get_property(mpv_, key.c_str(), MPV_FORMAT_INT64, &candidate) < 0) break;
+            if (candidate == id) { index = i; break; }
+        }
+    }
+    if (index < 0) {
+        const char* clear[] = {"playlist-clear", nullptr};
+        (void)mpv_command(mpv_, clear); return false;
+    }
+    {
+        std::lock_guard<std::mutex> lock(cb_mutex_);
+        done_callback_ = std::move(done_callback);
+    }
+    exclusive_entry_id_ = id;
+    const std::string pos = std::to_string(index);
+    const char* play[] = {"playlist-play-index", pos.c_str(), nullptr};
+    if (mpv_command(mpv_, play) < 0) {
+        exclusive_entry_id_ = -1;
+        { std::lock_guard<std::mutex> lock(cb_mutex_); done_callback_ = nullptr; }
+        const char* clear[] = {"playlist-clear", nullptr};
+        (void)mpv_command(mpv_, clear); return false;
+    }
+    stop_barrier_ = false;
+    state_.store(PlayerState::kLoading, std::memory_order_relaxed);
+    return true;
+}
+void LibMpvPlayer::ReleaseExclusive() { exclusive_ = false; exclusive_gain_ = 1.0; SetVolume(user_volume_); }
+
+bool LibMpvPlayer::SetExclusiveGain(double gain) {
+    if (!exclusive_ || !mpv_ || gain < 0.05 || gain > 1.0) return false;
+    exclusive_gain_ = gain;
+    double percent = std::sqrt(user_volume_) * 100.0 * gain;
+    return mpv_set_property(mpv_, "volume", MPV_FORMAT_DOUBLE, &percent) >= 0;
+}
+
+void LibMpvPlayer::PlayImpl(const std::string& url,
+                            std::function<void()> done_callback) {
+    if (mpv_ == nullptr) {
+        LVA_LOGW(kTag, "Play(%s) ignored: mpv not initialized",
+                 url.c_str());
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(cb_mutex_);
+        done_callback_ = std::move(done_callback);
+    }
+
+    const char* args[] = {"loadfile", url.c_str(), "replace", nullptr};
+    if (const int rc = mpv_command(mpv_, args); rc < 0) {
+        LVA_LOGE(kTag, "loadfile(%s) failed: %s", url.c_str(),
+                 mpv_error_string(rc));
+        std::lock_guard<std::mutex> lk(cb_mutex_);
+        done_callback_ = nullptr;
+        return;
+    }
+    state_.store(PlayerState::kLoading, std::memory_order_relaxed);
+    LVA_LOGI(kTag, "Play: %s", url.c_str());
+}
+
+void LibMpvPlayer::Pause() {
+    if (mpv_ == nullptr) return;
+    int yes = 1;
+    if (const int rc = mpv_set_property(mpv_, "pause", MPV_FORMAT_FLAG, &yes);
+        rc < 0) {
+        LVA_LOGW(kTag, "pause set failed: %s", mpv_error_string(rc));
+        return;
+    }
+    state_.store(PlayerState::kPaused, std::memory_order_relaxed);
+}
+
+void LibMpvPlayer::Resume() {
+    if (mpv_ == nullptr) return;
+    int no = 0;
+    if (const int rc = mpv_set_property(mpv_, "pause", MPV_FORMAT_FLAG, &no);
+        rc < 0) {
+        LVA_LOGW(kTag, "resume set failed: %s", mpv_error_string(rc));
+        return;
+    }
+    state_.store(PlayerState::kPlaying, std::memory_order_relaxed);
+}
+
+void LibMpvPlayer::Stop() {
+    if (exclusive_entry_id_ >= 0) retired_exclusive_id_ = exclusive_entry_id_;
+    exclusive_entry_id_ = -1; stop_barrier_ = false;
+    if (mpv_ == nullptr) return;
+    {
+        std::lock_guard<std::mutex> lk(cb_mutex_);
+        done_callback_ = nullptr;
+    }
+    const char* args[] = {"stop", nullptr};
+    if (const int rc = mpv_command(mpv_, args); rc < 0) {
+        LVA_LOGW(kTag, "stop failed: %s", mpv_error_string(rc));
+        return;
+    }
+    stop_barrier_ = true; await_idle_ = started_entry_id_ >= 0;
+    // END_FILE publishes Idle on the main event loop, including stop-keyword requests.
+}
+
+void LibMpvPlayer::SetVolume(double normalized) {
+    user_volume_ = Clamp01(normalized);
+    if (mpv_ == nullptr) return;
+    // Use sqrt curve to match sendspin's software attenuation.
+    // This gives a gentler rolloff: 50% → ~71% output.
+    double percent = std::sqrt(user_volume_) * 100.0 * (exclusive_ ? exclusive_gain_ : 1.0);
+    if (const int rc = mpv_set_property(mpv_, "volume",
+                                        MPV_FORMAT_DOUBLE, &percent);
+        rc < 0) {
+        LVA_LOGW(kTag, "volume set failed: %s", mpv_error_string(rc));
+    }
+}
+
+PlayerState LibMpvPlayer::State() const {
+    return state_.load(std::memory_order_relaxed);
+}
+
+void LibMpvPlayer::SetStateChangedCallback(
+    std::function<void(PlayerState)> on_state_changed) {
+    on_state_changed_ = std::move(on_state_changed);
+}
+
+}  // namespace lva::audio
