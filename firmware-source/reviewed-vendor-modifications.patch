+void LibMpvPlayer::OnMpvWakeupTrampoline(void* opaque) {
+    auto* self = static_cast<LibMpvPlayer*>(opaque);
+    if (self == nullptr || self->wakeup_write_fd_ < 0) return;
+    const std::uint64_t value = 1;
+    ssize_t r;
+    do {
